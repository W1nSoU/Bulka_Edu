# ══════════════════════════════════════════════════════════════════════════════
# .env.docker.example  — copy to .env before running docker-compose
# Fill ALL values before production deployment.
# ══════════════════════════════════════════════════════════════════════════════

# ── Telegram Education Bot ────────────────────────────────────────────────────
BOT_API_TOKEN=your_bot_token_here
DEV_CHAT_ID=your_dev_chat_id
MAIN_DEVELOPER_ID=738460434
GROQ_API_KEY=
DAYS_TOTAL=5
DEBUG=false
LOG_TO_FILE=true

# ── License Verification Server ───────────────────────────────────────────────
VERIFY_PORT=8443
API_SECRET_KEY=change_this_to_a_random_secret_64chars
# Internal Docker network — bots call server by service name
LICENSE_VERIFY_URL=http://verify-api:8443/api/verify
LICENSE_TIMEOUT=10
LICENSE_SSL_VERIFY=false

# ── HARDWARE_ID_OVERRIDE (CRITICAL) ──────────────────────────────────────────
# Generate ONCE per deployment, NEVER change:
#   python3 -c "import secrets; print(secrets.token_hex(16))"
# This value becomes the stable hardware fingerprint for this Docker instance.
# Changing it will BLOCK the bot and may trigger self-destruct.
HARDWARE_ID_OVERRIDE=

# ── Telegram Master Bot ───────────────────────────────────────────────────────
MASTER_BOT_TOKEN=your_master_bot_token_here
MASTER_CHAT_ID=your_telegram_chat_id
MASTER_ALLOWED_IDS=your_telegram_user_id
NOTIFY_ON_OK_FIRST=true
NOTIFY_ON_OK_REPEAT=false

# ── SSL (optional, for HTTPS verify-api) ─────────────────────────────────────
SSL_CERTFILE=
SSL_KEYFILE=
